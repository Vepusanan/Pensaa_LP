---
interface Props {
  label: string;
  /** Drop in real media later: { type: "video" | "iframe" | "image", src, title? } */
  media?: { type: "video" | "iframe" | "image"; src: string; title?: string };
}

const { label, media } = Astro.props;

// Decorative slide controls under the demo; the middle one is highlighted.
const controls = [
  "M15 6l-6 6 6 6",
  "M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z",
  "M8 5.5v13l10.5-6.5z",
  "M9 6l6 6-6 6",
  "M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5",
];
---

<figure class="rounded-[22px] border border-surface bg-surface/70 p-1.5 shadow-[0_30px_80px_-30px_color-mix(in_oklab,var(--color-brand)_45%,transparent)] ring-1 ring-ink/5 md:p-2">
  <div class="aspect-16/10 overflow-hidden rounded-[16px] bg-paper">
    {
      media?.type === "video" ? (
        <video class="size-full object-cover" src={media.src} title={media.title ?? label} autoplay muted loop playsinline />
      ) : media?.type === "iframe" ? (
        <iframe class="size-full" src={media.src} title={media.title ?? label} loading="lazy" allowfullscreen />
      ) : media?.type === "image" ? (
        <img class="size-full object-cover" src={media.src} alt={media.title ?? label} width="1600" height="1000" />
      ) : (
        <div class="grid size-full place-items-center bg-linear-to-br from-brand-soft via-surface to-brand-soft">
          <div class="flex flex-col items-center gap-3">
            <span class="grid size-14 place-items-center rounded-full bg-brand text-brand-ink shadow-soft" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="ml-0.5 size-6" fill="currentColor"><path d="M8 5.5v13l10.5-6.5z" /></svg>
            </span>
            <span class="font-display text-lg font-semibold text-ink">{label}</span>
          </div>
        </div>
      )
    }
  </div>
  <div class="flex items-center justify-center gap-2 py-2.5 md:py-3" aria-hidden="true">
    {
      controls.map((d, i) => (
        <span
          class:list={[
            "grid size-8 place-items-center rounded-lg border md:size-9",
            i === 2 ? "border-brand/20 bg-brand-soft text-brand" : "border-line bg-surface text-muted",
          ]}
        >
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d={d} />
          </svg>
        </span>
      ))
    }
  </div>
</figure>
