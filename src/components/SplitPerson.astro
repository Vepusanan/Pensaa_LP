---
interface Props {
  label: string;
  teach: string;
  learn: string;
}

const { label, teach, learn } = Astro.props;
---

<figure class="mx-auto w-full max-w-[320px]">
  <svg viewBox="0 0 320 360" class="h-auto w-full" role="img" aria-label={label}>
    <defs>
      <clipPath id="split-left"><rect x="0" y="0" width="160" height="360"></rect></clipPath>
      <clipPath id="split-right"><rect x="160" y="0" width="160" height="360"></rect></clipPath>
    </defs>

    <circle cx="160" cy="200" r="140" fill="var(--color-brand-soft)"></circle>

    <!-- Pointer (teacher) -->
    <line x1="58" y1="182" x2="22" y2="92" stroke="var(--color-ink)" stroke-width="5" stroke-linecap="round"></line>
    <circle cx="22" cy="92" r="6" fill="var(--color-accent-red)"></circle>
    <line x1="104" y1="246" x2="62" y2="190" stroke="var(--color-ink)" stroke-width="24" stroke-linecap="round"></line>
    <circle cx="58" cy="182" r="12" fill="var(--color-accent-amber-soft)"></circle>

    <!-- Torso -->
    <g clip-path="url(#split-left)">
      <path d="M86 360V258c0-44 30-70 74-72 44 2 74 28 74 72v102z" fill="var(--color-ink)"></path>
      <path d="M140 188l20 58 20-58z" fill="var(--color-surface)"></path>
      <path d="M160 196l-8 10 4 38 4 8z" fill="var(--color-brand)"></path>
      <path d="M134 192l26 70" stroke="var(--color-muted)" stroke-width="3" fill="none"></path>
    </g>
    <g clip-path="url(#split-right)">
      <path d="M86 360V258c0-44 30-70 74-72 44 2 74 28 74 72v102z" fill="var(--color-brand)"></path>
      <path d="M118 200c10-14 26-20 42-20s32 6 42 20c-12 10-26 14-42 14s-30-4-42-14z" fill="var(--color-ink)" opacity="0.22"></path>
      <line x1="174" y1="212" x2="174" y2="246" stroke="var(--color-surface)" stroke-width="3" stroke-linecap="round"></line>
      <rect x="168" y="290" width="54" height="32" rx="10" fill="var(--color-ink)" opacity="0.18"></rect>
    </g>

    <!-- Book (student) -->
    <line x1="216" y1="246" x2="252" y2="264" stroke="var(--color-brand)" stroke-width="24" stroke-linecap="round"></line>
    <g transform="rotate(-10 268 252)">
      <rect x="236" y="226" width="66" height="50" rx="4" fill="var(--color-accent-amber)"></rect>
      <rect x="242" y="230" width="56" height="42" rx="2" fill="var(--color-surface)"></rect>
      <line x1="270" y1="230" x2="270" y2="272" stroke="var(--color-line)" stroke-width="2"></line>
      <path d="M248 240h16M248 248h16M276 240h16M276 248h12" stroke="var(--color-muted)" stroke-width="2" stroke-linecap="round"></path>
    </g>
    <circle cx="254" cy="266" r="12" fill="var(--color-accent-amber-soft)"></circle>

    <!-- Head -->
    <rect x="147" y="150" width="26" height="40" rx="8" fill="var(--color-accent-amber-soft)"></rect>
    <circle cx="160" cy="112" r="46" fill="var(--color-accent-amber-soft)"></circle>
    <g clip-path="url(#split-left)">
      <path d="M114 108c0-30 20-46 46-46v22c-18 0-30 6-34 24z" fill="var(--color-ink)"></path>
      <circle cx="142" cy="116" r="11" fill="none" stroke="var(--color-ink)" stroke-width="3"></circle>
    </g>
    <g clip-path="url(#split-right)">
      <path d="M160 62c26 0 46 16 46 46l-8 4-6-14-8 10-8-14-8 12-8-16z" fill="var(--color-ink)"></path>
    </g>
    <circle cx="142" cy="116" r="4" fill="var(--color-ink)"></circle>
    <circle cx="178" cy="116" r="4" fill="var(--color-ink)"></circle>
    <path d="M148 134q12 10 24 0" fill="none" stroke="var(--color-ink)" stroke-width="3" stroke-linecap="round"></path>

    <line x1="160" y1="40" x2="160" y2="352" stroke="var(--color-surface)" stroke-width="2" stroke-dasharray="4 6"></line>
  </svg>
  <figcaption class="mt-4 flex items-center justify-center gap-3 text-sm font-semibold" aria-hidden="true">
    <span class="rounded-full bg-ink px-3 py-1 text-paper">{teach}</span>
    <span class="text-muted">/</span>
    <span class="rounded-full bg-brand px-3 py-1 text-brand-ink">{learn}</span>
  </figcaption>
</figure>
