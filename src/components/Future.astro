---
import { future } from "../data/content";
import Badge from "./ui/Badge.astro";
import Icon from "./ui/Icon.astro";
import Reveal from "./ui/Reveal.astro";
import SectionHeading from "./ui/SectionHeading.astro";

// First card plain, second card in brand colour (pricing-pair layout)
const styles = [
  { card: "border border-line bg-surface", icon: "bg-brand-soft text-brand", body: "text-muted" },
  { card: "bg-brand text-brand-ink", icon: "bg-brand-ink text-brand", body: "text-brand-ink/85" },
];
---

<section id="future" class="section-y" aria-labelledby="future-title">
  <div class="container-page">
    <SectionHeading id="future-title" eyebrow={future.eyebrow} title={future.headline} muted={future.headlineMuted} />

    <ul class="mx-auto mt-14 grid max-w-[1000px] gap-5 md:mt-16 md:grid-cols-2">
      {
        future.cards.map((card, i) => {
          const s = styles[i % styles.length]!;
          return (
            <Reveal as="li" index={i}>
              <article class:list={["flex h-full flex-col rounded-card p-7 shadow-soft md:p-9", s.card]}>
                <div class="flex items-start justify-between gap-4">
                  <span class:list={["grid size-12 place-items-center rounded-2xl", s.icon]}>
                    <Icon name={card.icon} class="size-6" />
                  </span>
                  <Badge text={card.badge} tone={card.tone} />
                </div>
                <h3 class="mt-10 text-2xl font-bold tracking-tight text-current md:text-3xl">{card.title}</h3>
                <p class:list={["mt-3", s.body]}>{card.body}</p>
              </article>
            </Reveal>
          );
        })
      }
    </ul>
  </div>
</section>
