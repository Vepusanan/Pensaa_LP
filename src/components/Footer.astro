---
import { footer, legal } from "../data/content";
import { formEndpoint } from "../lib/links";

const { capture } = footer;
const mailto = `mailto:${footer.email}`;
---

<footer class="bg-ink pt-20 pb-10 text-paper md:pt-28">
  <div class="container-page">
    <div class="mx-auto max-w-[760px] text-center">
      <h2 class="font-display text-[clamp(2.5rem,6vw,4.5rem)] leading-none font-bold tracking-tight text-paper">
        {footer.heading}
      </h2>
      <p class="mx-auto mt-5 max-w-[52ch] text-paper/70">{footer.body}</p>
      <p class="mt-4 text-paper/70">
        {footer.contactLabel}{" "}
        <a href={mailto} class="font-semibold text-paper underline decoration-brand decoration-2 underline-offset-4 hover:text-brand-soft">{footer.email}</a>
      </p>
    </div>

    <div class="mx-auto mt-12 max-w-[640px] rounded-card bg-brand-soft p-7 text-ink md:p-9">
      <h3 class="text-2xl font-bold tracking-tight">{capture.heading}</h3>
      <p class="mt-2 text-ink/80">{capture.body}</p>
      <form
        id="contact-form"
        class="mt-6"
        method="POST"
        action={formEndpoint || mailto}
        enctype={formEndpoint ? undefined : "text/plain"}
        data-endpoint={formEndpoint}
        data-mailto={mailto}
        data-subject={capture.mailtoSubject}
        data-sending={capture.sending}
        data-success={capture.success}
        data-error={capture.error}
        data-mailto-opened={capture.mailtoOpened}
      >
        <div class="flex flex-col gap-3 sm:flex-row">
          <label for="contact-email" class="sr-only">{capture.label}</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder={capture.placeholder}
            class="h-12 min-w-0 flex-1 rounded-full border border-brand/20 bg-surface px-5 text-ink placeholder:text-muted focus:border-brand focus:outline-none focus-visible:ring-2 focus-visible:ring-brand/30"
          />
          <div class="absolute -left-[9999px]" aria-hidden="true">
            <label for="contact-company">{capture.honeypotLabel}</label>
            <input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <button
            type="submit"
            class="h-12 shrink-0 cursor-pointer rounded-full bg-brand px-6 text-[0.9375rem] font-semibold text-brand-ink shadow-soft transition-colors hover:bg-ink disabled:cursor-wait disabled:opacity-70"
          >
            {capture.button}
          </button>
        </div>
        <p id="contact-status" class="mt-3 min-h-6 text-sm font-medium" aria-live="polite"></p>
      </form>
    </div>

    <div class="mt-20 flex flex-col gap-4 border-t border-paper/15 pt-8 text-sm text-paper/65 md:flex-row md:items-center md:justify-between">
      <p>{legal.copyright}</p>
      <nav aria-label={legal.ariaLabel}>
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {
            legal.links.map((link) => (
              <li>
                <a href={link.href} class="hover:text-paper">{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</footer>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const status = document.getElementById("contact-status")!;
  const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
  const d = form.dataset;

  const say = (text: string, ok: boolean) => {
    status.textContent = text;
    status.classList.toggle("text-accent-green-ink", ok);
    status.classList.toggle("text-accent-red-ink", !ok);
  };

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    if (data.get("company")) return; // honeypot
    const email = String(data.get("email") ?? "");

    if (!d.endpoint) {
      window.location.href = `${d.mailto}?subject=${encodeURIComponent(d.subject!)}&body=${encodeURIComponent(email)}`;
      say(d.mailtoOpened!, true);
      return;
    }

    const label = button.textContent;
    button.disabled = true;
    button.textContent = d.sending!;
    try {
      const res = await fetch(d.endpoint, { method: "POST", body: data, headers: { Accept: "application/json" } });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      say(d.success!, true);
    } catch {
      say(d.error!, false);
    } finally {
      button.disabled = false;
      button.textContent = label;
    }
  });
</script>
