---
import { problem, type Accent } from "../data/content";
import { splitOn } from "../lib/links";
import Icon from "./ui/Icon.astro";
import Reveal from "./ui/Reveal.astro";
import SectionHeading from "./ui/SectionHeading.astro";

const parts = splitOn(problem.headline, problem.highlight);

const tiles: Record<Accent, { card: string; chip: string }> = {
  red: { card: "bg-accent-red text-white", chip: "bg-white/25 text-white" },
  amber: { card: "bg-accent-amber text-ink", chip: "bg-ink/10 text-ink" },
  blue: { card: "bg-brand text-brand-ink", chip: "bg-white/20 text-white" },
  green: { card: "bg-accent-green text-white", chip: "bg-white/25 text-white" },
};
// Bento widths on a 12-col grid: wide/narrow, then narrow/wide
const spans = ["md:col-span-7", "md:col-span-5", "md:col-span-5", "md:col-span-7"];
---

<section id="problem" class="section-y" aria-labelledby="problem-title">
  <div class="container-page">
    <SectionHeading id="problem-title" eyebrow={problem.eyebrow} title={problem.headline} body={problem.body}>
      {
        parts ? (
          <>
            {parts[0]}
            <span class="text-[1.45em] leading-none text-brand">{parts[1]}</span>
            {parts[2]}
          </>
        ) : (
          problem.headline
        )
      }
    </SectionHeading>

    <ul class="mt-14 grid gap-3 md:grid-cols-12 md:gap-4">
      {
        problem.cards.map((card, i) => (
          <Reveal as="li" index={i} class={spans[i % spans.length]}>
            <div class:list={["flex h-full min-h-[190px] flex-col justify-between gap-8 rounded-xl p-5 md:min-h-[210px] md:p-6", tiles[card.accent].card]}>
              <span class:list={["grid size-12 place-items-center rounded-full", tiles[card.accent].chip]}>
                <Icon name={card.icon} class="size-5" />
              </span>
              <p class="max-w-[28ch] text-xl leading-snug font-medium tracking-tight md:text-2xl">{card.text}</p>
            </div>
          </Reveal>
        ))
      }
    </ul>
  </div>
</section>
