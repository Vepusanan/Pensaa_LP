---
import type { HTMLTag } from "astro/types";

interface Props {
  as?: HTMLTag;
  /** Position in a group; each step adds 80ms of stagger. */
  index?: number;
  class?: string;
}

const { as: Tag = "div", index = 0, class: className } = Astro.props;
---

<Tag class:list={["reveal", className]} style={index ? `--reveal-delay: ${index * 80}ms` : undefined}>
  <slot />
</Tag>
