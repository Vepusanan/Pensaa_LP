---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  href: string;
  variant?: "primary" | "secondary" | "ghost" | "soft";
  size?: "md" | "sm";
  shape?: "pill" | "rounded";
}

const { href, variant = "primary", size = "md", shape = "pill", class: className, ...rest } = Astro.props;

const variants = {
  primary: "bg-brand text-brand-ink shadow-soft hover:bg-ink",
  secondary: "border border-line bg-surface text-ink hover:border-ink",
  ghost: "text-ink hover:text-brand",
  soft: "bg-ink/[0.06] text-ink hover:bg-ink/10",
};
const sizes = { md: "h-12 px-6 text-[0.9375rem]", sm: "h-10 px-4 text-sm" };
---

<a
  href={href}
  class:list={[
    "inline-flex items-center justify-center gap-2 font-semibold whitespace-nowrap transition-colors duration-200",
    shape === "pill" ? "rounded-full" : "rounded-xl",
    variants[variant],
    sizes[size],
    className,
  ]}
  {...rest}
>
  <slot />
</a>
