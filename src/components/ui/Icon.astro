---
export type IconName = "x" | "clock" | "repeat" | "chart" | "institution" | "adaptive" | "arrow-down" | "plus" | "mail";

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = "size-6" } = Astro.props;

const paths: Record<IconName, string> = {
  x: "M6 6l12 12M18 6L6 18",
  clock: "M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z",
  repeat: "M17 2l4 4-4 4M3 11V9a3 3 0 0 1 3-3h15M7 22l-4-4 4-4M21 13v2a3 3 0 0 1-3 3H3",
  chart: "M4 20V10M10 20V4M16 20v-7M22 20H2",
  institution: "M3 21h18M5 21V10M19 21V10M9.5 21V10M14.5 21V10M2 10l10-6 10 6z",
  adaptive: "M4 18c3 0 4-12 8-12s5 12 8 12M4 6h3M17 18h3M12 14v.01",
  "arrow-down": "M12 5v14M6 13l6 6 6-6",
  plus: "M12 5v14M5 12h14",
  mail: "M3 6h18v12H3zM3 7l9 6 9-6",
};
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <path d={paths[name]} />
</svg>
