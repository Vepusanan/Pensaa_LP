---
import { audience, type AudienceCard } from "../data/content";
import Reveal from "./ui/Reveal.astro";
import SectionHeading from "./ui/SectionHeading.astro";
import SplitPerson from "./SplitPerson.astro";

const cards: { card: AudienceCard; tone: string; order: string }[] = [
  { card: audience.teachers, tone: "bg-ink", order: "lg:order-1" },
  { card: audience.students, tone: "bg-brand", order: "lg:order-3" },
];
---

<section id="audience" class="section-y bg-surface" aria-labelledby="audience-title">
  <div class="container-page">
    <SectionHeading
      id="audience-title"
      eyebrow={audience.eyebrow}
      title={audience.headline}
      muted={audience.headlineMuted}
    />

    <div class="mt-14 grid items-center gap-6 md:grid-cols-2 lg:mt-20 lg:grid-cols-[1fr_minmax(260px,320px)_1fr] lg:gap-10">
      <Reveal class="md:col-span-2 lg:order-2 lg:col-span-1">
        <SplitPerson label={audience.illustrationAlt} teach={audience.teachLabel} learn={audience.learnLabel} />
      </Reveal>
      {
        cards.map(({ card, tone, order }, i) => (
          <Reveal index={i + 1} class:list={["h-full", order]}>
            <article class="h-full rounded-card border border-line bg-paper p-7 shadow-soft md:p-8">
              <span class:list={["block h-1.5 w-10 rounded-full", tone]} aria-hidden="true" />
              <h3 class="mt-5 text-2xl font-bold tracking-tight">{card.title}</h3>
              <p class="mt-3 text-muted">{card.body}</p>
            </article>
          </Reveal>
        ))
      }
    </div>

    <Reveal>
      <p class="mx-auto mt-14 max-w-[60ch] text-center text-muted italic">{audience.caption}</p>
    </Reveal>
  </div>
</section>
